# MySQL
DATABASE_URL=mysql+pymysql://codepilot:codepilot@127.0.0.1:3306/codepilot

# OpenAI-compatible LLM（LLM_* 为标准命名，兼容旧 OPENAI_*）
# qwen 模型可不填 BASE_URL，自动使用 DashScope compatible-mode
LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
# Embedding（DashScope: text-embedding-v4）
# EMBEDDING_MODEL=text-embedding-v4

# RAG (Phase 3)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=codepilot_knowledge

# Agent
SHOPAI_ROOT=playground/shopai
AGENT_MAX_STEPS=16
# 能力开关：1=只读分析 2=+git/run_test 观测 3=+RAG 4=+写代码/分支 5=+多Agent
AGENT_PHASE=2
TEST_TIMEOUT_SECONDS=180
PROJECT_ROOT=.

# 平台化 (Phase 6)
# LLM 瞬时错误重试（连接/超时/429/5xx 指数退避；鉴权错误不重试）
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_SECONDS=1.0
# Guardrail：write_file 密钥扫描默认开启；diff 变更行数上限
# AGENT_MAX_DIFF_LINES=1000
# Memory：run 经验沉淀与召回注入
# MEMORY_ENABLED=true
# MEMORY_INJECT_LIMIT=3
