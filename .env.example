# MySQL
DATABASE_URL=mysql+pymysql://codepilot:codepilot@127.0.0.1:3306/codepilot

# OpenAI-compatible LLM（LLM_* 为标准命名，兼容旧 OPENAI_*）
# qwen 模型可不填 BASE_URL，自动使用 DashScope compatible-mode
LLM_API_KEY=sk-your-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
# Embedding（DashScope: text-embedding-v4）
# EMBEDDING_MODEL=text-embedding-v4

# RAG (Phase 3)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=codepilot_knowledge

# Agent
SHOPAI_ROOT=playground/shopai
AGENT_MAX_STEPS=16
# 能力开关：1=只读分析 2=+git/run_test 观测 3=+RAG 4=+写代码/分支
AGENT_PHASE=2
TEST_TIMEOUT_SECONDS=180
PROJECT_ROOT=.
